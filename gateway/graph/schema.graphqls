scalar Time

input RegisterInput {
    email: String!
    password: String!
    name: String!
}

input LoginInput {
    email: String!
    password: String!
}

input CreateEventInput {
    title: String!
    description: String
    venue: String!
    eventDate: Time!
    totalSeats: Int!
    priceMinor: Int64!
    currency: String!
}

enum EventField {
    title
    description
    venue
    eventDate
    totalSeats
    priceMinor
    currency
}

input UpdateEventInput {
    title: String
    description: String
    venue: String
    eventDate: Time
    totalSeats: Int
    priceMinor: Int64
    updateMask: [EventField!]
    currency: String
    expectedVersion: Int64!
}

input ListEventsInput {
    page: Int!
    pageSize: Int!
    searchQuery: String
}

scalar Int64

type Event {
    id: ID!
    title: String!
    description: String
    venue: String!
    eventDate: Time!
    totalSeats: Int!
    availableSeats: Int!
    priceMinor: Int64!
    createdAt: Time
    updatedAt: Time
    currency: String!
    version: Int64!
}

type EventList {
    events: [Event!]!
    totalCount: Int!
    page: Int!
    pageSize: Int!
}

type AuthPayload {
    userId: ID!
    accessToken: String!
    refreshToken: String!
    expiresIn: Int!
}

type GetMePayload {
    userId: ID!
    email: String!
    name: String!
    role: String!
    createdAt: String!
}

input RefreshTokenInput {
    refreshToken: String!
}

type RefreshTokenPayload {
    accessToken: String!
    expiresIn: Int!
}

type Query {
    getEvent(id: ID!): Event!
    listEvents(input: ListEventsInput!): EventList!
    getMe: GetMePayload!
}

type Mutation {
    register(input: RegisterInput!): AuthPayload!
    login(input: LoginInput!): AuthPayload!
    logout(refreshToken: String!): Boolean!
    refreshToken(input: RefreshTokenInput!): RefreshTokenPayload!
    
    createEvent(input: CreateEventInput!): Event!
    updateEvent(id: ID!, input: UpdateEventInput!): Event!
    deleteEvent(id: ID!, expectedVersion: Int64!): Boolean!
}